rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function signedIn() { return request.auth != null; }

    // Public catalog: anyone can read active products; only admins write.
    match /products/{id} {
      allow read: if resource.data.is_active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /boxes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are created ONLY by the createOrderAndPayment Cloud Function (Admin SDK).
    // Customers may read their own order (by uid or the anonymous uid that placed it); admins read/update all.
    match /orders/{id} {
      allow create, delete: if false;
      allow read: if isAdmin() || (signedIn() && (resource.data.user_id == request.auth.uid || resource.data.auth_uid == request.auth.uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order_status', 'updated_at', 'admin_notes'])
        && request.resource.data.order_status in ['received', 'baking', 'shipped', 'delivered'];
    }

    match /{document=**} { allow read, write: if false; }
  }
}

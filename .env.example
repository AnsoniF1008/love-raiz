VITE_WHATSAPP_NUMBER=13468339153
# Optional live Instagram grid. Create a free feed at https://behold.so, connect @love.raiz, paste the feed id.
VITE_BEHOLD_ID=
# reCAPTCHA v3 site key for App Check. Leave empty to keep App Check off; once set,
# also set ENFORCE_APP_CHECK=1 in functions/.env so the callable requires a token.
VITE_RECAPTCHA_SITE_KEY=
# Leave VITE_STRIPE_PUBLISHABLE_KEY empty to take orders with payment on delivery
# (cash / Zelle): no Cloud Functions, runs on the free Firebase plan. Set it to
# switch the checkout to card payments (needs the Blaze plan and `npm run deploy:full`).
# Product photos are stored inside each product by default. Set to 1 to upload
# them to Cloud Storage instead (Blaze plan).
VITE_USE_STORAGE=
